# The public URL where the invitation will be hosted (no trailing slash).
# WhatsApp and other apps need an ABSOLUTE image URL for the link preview,
# so set this before running `npm run build` for the final deploy.
# Default (already built in): https://vignesh-keerthana.pages.dev
# Only set this if you use a different domain.
VITE_SITE_URL=https://vignesh-keerthana.pages.dev
